# NoticeTrust Environment Configuration
# Copy this file to .env and fill in your Supabase project keys

# Frontend Public Keys (Safe for browser)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Demo Simulation & Offline Mode
# Set to 'true' to allow seamless judge testing with embedded SQLite/IndexedDB simulation when offline
VITE_ENABLE_LOCAL_SIMULATION=true

# Canonical Application Base URL for QR Codes & Trust Passports
VITE_APP_BASE_URL=http://localhost:5173
